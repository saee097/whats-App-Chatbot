  "knowledge": [
    {
      "id": "kb_shipping",
      "title": "Shipping & delivery times",
      "category": "Orders",
      "status": "published",
      "content": "Harbor & Co ships roasted-to-order coffee within 24 hours on business days. Standard delivery is 3-5 business days in the US, 5-8 internationally. Subscriptions ship on the customer's chosen roast day. Tracking is emailed when the label is created. Free shipping on orders over $45.",
      "createdAt": "2026-08-06T02:28:24.671Z",
      "updatedAt": "2026-08-24T02:28:24.671Z"
    },
    {
      "id": "kb_returns",
      "title": "Returns and freshness guarantee",
      "category": "Orders",
      "status": "published",
      "content": "Unopened bags can be returned within 30 days. If beans arrive stale or damaged we replace the bag at no cost. Opened coffee is not returnable except for quality issues. Email  or chat with order number. Refunds appear in 5-7 business days.",
      "createdAt": "2026-08-08T02:28:24.671Z",
      "updatedAt": "2026-08-23T02:28:24.671Z"
    },
    {
      "id": "kb_subscribe",
      "title": "How subscriptions work",
      "category": "Products",
      "status": "published",
      "content": "Choose roast profile, bag size (250g or 1kg), and cadence (weekly, biweekly, monthly). Pause anytime from the account page or by messaging us. Skip the next shipment by saying 'skip next bag'. Change origin anytime before the roast cutoff (48 hours before ship day).",
      "createdAt": "2026-08-10T02:28:24.671Z",
      "updatedAt": "2026-08-25T02:28:24.671Z"
    },
    {
      "id": "kb_hours",
      "title": "Support hours and human handoff",
      "category": "Support",
      "status": "published",
      "content": "Aether AI handles most questions 24/7. Human specialists are available weekdays 9:00-18:00 Pacific. Ask for a human, type 'agent', or say 'talk to someone' to pause the bot. After hours we queue the conversation and reply first thing next business morning.",
      "createdAt": "2026-08-14T02:28:24.671Z",
      "updatedAt": "2026-08-14T02:28:24.671Z"
    },
    {
      "id": "kb_whatsapp",
      "title": "WhatsApp ordering",
      "category": "Channels",
      "status": "published",
      "content": "Message Harbor & Co on WhatsApp at the business number listed on the website. You can check order status, change a subscription, or get roast recommendations. Replies come from the same Aether assistant as the website widget, with full conversation history.",
      "createdAt": "2026-08-17T02:28:24.671Z",
      "updatedAt": "2026-08-17T02:28:24.671Z"
    },
    {
      "id": "kb_ethiopia",
      "title": "Ethiopia Guji tasting notes",
      "category": "Products",
      "status": "published",
      "content": "Ethiopia Guji is a washed lot with jasmine, bergamot, and ripe peach. Recommended as pour-over at 93C, 1:16 ratio. Light-medium roast. 250g is $18, 1kg is $62. Currently in stock.",
      "createdAt": "2026-08-22T02:28:24.671Z",
      "updatedAt": "2026-08-22T02:28:24.671Z"
    }
  ],
